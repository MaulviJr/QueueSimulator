<Window x:Class="QueueingCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queueing Calculator and Simulator" Height="720" Width="900"
        WindowStartupLocation="CenterScreen">
    <TabControl>

        <!-- TAB 1: the calculator (same controls as before) -->
        <TabItem Header="Calculator">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Select model" FontWeight="Bold" />
                    <ComboBox x:Name="cmbModel" Margin="0,5,0,10"
                              SelectionChanged="cmbModel_SelectionChanged" />
                    <TextBlock x:Name="lblArrDist" Text="Arrival time distribution" FontWeight="Bold" />
                    <ComboBox x:Name="cmbArrDist" Margin="0,5,0,10"
                              SelectionChanged="cmbDist_SelectionChanged" />
                    <TextBlock x:Name="lblSvcDist" Text="Service time distribution" FontWeight="Bold" />
                    <ComboBox x:Name="cmbSvcDist" Margin="0,5,0,10"
                              SelectionChanged="cmbDist_SelectionChanged" />
                    <Button x:Name="btnMode" Padding="6" Margin="0,0,0,10" Click="btnMode_Click" />
                    <TextBlock x:Name="lblInfo" TextWrapping="Wrap" Margin="0,0,0,15" />

                    <TextBlock x:Name="lbl1" />
                    <TextBox x:Name="txt1" Margin="0,2,0,8" />
                    <TextBlock x:Name="lbl2" />
                    <TextBox x:Name="txt2" Margin="0,2,0,8" />
                    <TextBlock x:Name="lbl3" />
                    <TextBox x:Name="txt3" Margin="0,2,0,8" />
                    <TextBlock x:Name="lbl4" />
                    <TextBox x:Name="txt4" Margin="0,2,0,8" />

                    <Button x:Name="btnCalculate" Content="Calculate" Padding="6"
                            Margin="0,10,0,15" Click="btnCalculate_Click" />
                    <TextBlock x:Name="txtResult" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- TAB 2: the simulation with a SEPARATE line in front of every counter
             (code in MainWindow.Simulation.cs and SimulationEngine.cs) -->
        <TabItem Header="Simulation">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Multi-counter simulation, like the real shop: every counter has its OWN line (first come, first served inside each line). A new customer joins the line with the fewest people (waiting + being served); an idle counter counts as 0 people, and if lines are equal the lowest-numbered counter is used. Customers do not change line afterwards. Use minutes everywhere." />
                    <Button x:Name="btnPreset" Content="Load Carrefour values" Padding="6"
                            Margin="0,0,0,10" Click="btnPreset_Click" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Arrival rate of the WHOLE shop (customers per minute)" Margin="0,5,0,0" />
                        <TextBox x:Name="txtSimLambda" Grid.Row="0" Grid.Column="1" Text="1.29" Margin="0,2,8,2" />

                        <TextBlock Grid.Row="1" Text="Mean service time per customer (minutes), all counters combined" Margin="0,5,0,0" />
                        <TextBox x:Name="txtSimMean" Grid.Row="1" Grid.Column="1" Text="2.73" Margin="0,2,8,2" />

                        <TextBlock Grid.Row="2" Text="Number of counters c (1 to 30), one line each" Margin="0,5,0,0" />
                        <TextBox x:Name="txtSimServers" Grid.Row="2" Grid.Column="1" Text="5" Margin="0,2,8,2" />

                        <TextBlock Grid.Row="3" Text="Simulation length (minutes of arrivals)" Margin="0,5,0,0" />
                        <TextBox x:Name="txtSimDuration" Grid.Row="3" Grid.Column="1" Text="88" Margin="0,2,8,2" />

                    </Grid>

                    <Button x:Name="btnRun" Content="Run simulation" Padding="10,6" HorizontalAlignment="Left"
                            Margin="0,0,0,15" Click="btnRun_Click" />

                    <TextBlock x:Name="txtSimResult" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,15" />

                    <TextBlock Text="Gantt chart (one lane per counter)" FontWeight="Bold" Margin="0,0,0,5" />
                    <Canvas x:Name="canGantt" Width="820" Height="200" Background="White" HorizontalAlignment="Left" Margin="0,0,0,15" />

                    <TextBlock Text="Queue length over time (all lines together)" FontWeight="Bold" Margin="0,0,0,5" />
                    <Canvas x:Name="canQueue" Width="820" Height="260" Background="White" HorizontalAlignment="Left" Margin="0,0,0,15" />

                    <TextBlock Text="Average waiting time as the simulation goes on" FontWeight="Bold" Margin="0,0,0,5" />
                    <Canvas x:Name="canWait" Width="820" Height="260" Background="White" HorizontalAlignment="Left" Margin="0,0,0,15" />

                    <TextBlock Text="Utilization of each counter (share of the total service time) and their total" FontWeight="Bold" Margin="0,0,0,5" />
                    <Canvas x:Name="canUtil" Width="820" Height="260" Background="White" HorizontalAlignment="Left" Margin="0,0,0,15" />

                    <TextBlock Text="Customer table" FontWeight="Bold" Margin="0,0,0,5" />
                    <DataGrid x:Name="dgCustomers" Height="300" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Arrival" Binding="{Binding ArrivalTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="Counter" Binding="{Binding Server}" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="Wait" Binding="{Binding WaitingTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="Turnaround" Binding="{Binding TurnaroundTime, StringFormat=F2}" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
